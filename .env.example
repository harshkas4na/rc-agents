# ─────────────────────────────────────────────
# REQUIRED: Server wallet (receives x402 USDC, owns the CC)
# ─────────────────────────────────────────────
DCA_STRATEGY_REACTIVE_ADDRESS=

# ─────────────────────────────────────────────
# x402 facilitator
#   Testnet:  https://x402.org/facilitator
#   Mainnet:  https://api.cdp.coinbase.com/platform/v2/x402
# ─────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# ─────────────────────────────────────────────
# Optional: CDP credentials (mainnet only)
# ─────────────────────────────────────────────
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ─────────────────────────────────────────────
# RPC URLs
# ─────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────
# Bridge mode (dry = log only, live = execute swap + bridge)
# ─────────────────────────────────────────────
BRIDGE_MODE=dry

# ─────────────────────────────────────────────
# GOAT Network (Bitcoin L2, BitVM2) — see /goat-research
#   Gas token is BTC. Testnet3 faucet: https://bridge.testnet3.goat.network/faucet
#   DCA swap venue (own Uniswap V3 Core deployment, live 2026-08-01 — see
#   goat-research/07-testnet3-deployment.md) is hardcoded in
#   src/config/contracts.ts as GOAT_TESTNET3_CONTRACTS, not sourced from env.
# ─────────────────────────────────────────────
GOAT_TESTNET3_RPC_URL=https://rpc.testnet3.goat.network
GOAT_MAINNET_RPC_URL=https://rpc.goat.network

# GOAT deployer wallet — testnet-only, do not reuse for anything real
GOAT_DEPLOYER_ADDRESS=
GOAT_DEPLOYER_PRIVATE_KEY=

# TODO(verify on-chain before use — see goat-research/03, 05): BIMA's Testnet3
# core market contract wasn't locatable by name search; needs direct app
# verification before this gets filled in.
BIMA_MARKET_ADDRESS=
