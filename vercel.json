{
  "version": 2,
  "builds": [
    {
      "src": "src/server/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["openapi.yaml", "SKILLS.md"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/goat/dca/tick",
      "schedule": "0 0 * * *"
    }
  ]
}
